        {
          "id": "fd1670ce-5d61-4a7b-9f6f-d4b5a62f0c14",
          "name": "Delete a Matching Criteria from a Resource Definition.",
          "request": {
            "name": "Delete a Matching Criteria from a Resource Definition.",
            "description": {
              "content": "If there **are no** Active Resources that would match to a different Resource Definition when the current Matching Criteria is deleted, the Matching Criteria is deleted immediately.\n\nIf there **are** Active Resources that would match to a different Resource Definition, the request fails with HTTP status code 409 (Conflict). The response content will list all of affected Active Resources and their new matches.\n\nThe request can take an optional `force` query parameter. If set to `true`, the Matching Criteria is deleted immediately. Referenced Active Resources would match to a different Resource Definition during the next deployment in the target environment.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "orgs",
                ":orgId",
                "resources",
                "defs",
                ":defId",
                "criteria",
                ":criteriaId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "force",
                  "value": "<boolean>",
                  "description": "If set to `true`, the Matching Criteria is deleted immediately, even if this action affects existing Active Resources.\n\n"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "orgId",
                  "description": "(Required) The Organization ID.\n\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "defId",
                  "description": "(Required) The Resource Definition ID.\n\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "criteriaId",
                  "description": "(Required) The Matching Criteria ID.\n\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
          "response": [
            {
              "id": "560d4169-a8f5-4e6a-a137-a588cba70b98",
              "name": "Record deleted.\n\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "orgs",
                    ":orgId",
                    "resources",
                    "defs",
                    ":defId",
