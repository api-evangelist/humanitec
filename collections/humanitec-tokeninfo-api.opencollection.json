          },
          "http": {
            "method": "DELETE",
            "url": "https://api.humanitec.io/users/:userId/tokens/:tokenId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The user ID.\n\n"
              },
              {
                "name": "tokenId",
                "value": "",
                "type": "path",
                "description": "The token ID.\n\n"
              }
            ]
          },
          "docs": "This endpoint deletes a user's session token. The deleted token can no longer be used to access the API. All other tokens for this user can still be used."
