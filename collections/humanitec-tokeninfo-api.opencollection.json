        {
          "info": {
            "name": "Gets a specific token associated with a user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.humanitec.io/users/:userId/tokens/:tokenId",
            "params": [
              {
                "name": "userId",
