                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The Application ID.\n\n"
              },
              {
                "name": "envId",
                "value": "",
                "type": "path",
                "description": "The Environment ID.\n\n"
              }
            ]
          },
          "docs": "Gets a specific Environment in an Application."
        },
        {
