            "name": "Get a specific Environment.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.humanitec.io/orgs/:orgId/apps/:appId/envs/:envId",
            "params": [
              {
                "name": "orgId",
                "value": "",
