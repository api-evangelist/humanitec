                "description": "The Application ID.\n\n"
              },
              {
                "name": "envId",
                "value": "",
                "type": "path",
                "description": "The Environment ID.\n\n"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a specific Environment in an Application."
        },
        {
          "info": {
            "name": "Delete a specific Environment.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.humanitec.io/orgs/:orgId/apps/:appId/envs/:envId",
            "params": [
              {
                "name": "orgId",
                "value": "",
