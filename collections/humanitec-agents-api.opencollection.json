                "name": "orgId",
                "value": "sample-org",
                "type": "path",
                "description": "The Organization ID"
              },
              {
                "name": "agentId",
                "value": "my-agent",
                "type": "path",
                "description": "The Agent id."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the description of an Agent."
        },
        {
          "info": {
            "name": "Delete an Agent (and its keys) stored under an Organization.",
