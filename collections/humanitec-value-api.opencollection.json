              {
                "name": "appId",
                "value": "",
                "type": "path",
                "description": "The Application ID.\n\n"
              },
              {
                "name": "envId",
                "value": "",
                "type": "path",
                "description": "The Environment ID.\n\n"
              },
              {
                "name": "key",
                "value": "",
                "type": "path",
                "description": "The key to update.\n\n"
              }
            ]
          },
          "docs": "The specified Shared Value will be permanently deleted. If the Shared Value is marked as a secret, it will also be permanently deleted."
        },
        {
          "info": {
            "name": "List Shared Values in an Application",
            "type": "http"
