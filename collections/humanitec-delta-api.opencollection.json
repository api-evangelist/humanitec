            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.humanitec.io/orgs/:orgId/apps/:appId/deltas",
            "params": [
              {
                "name": "orgId",
                "value": "sample-org",
                "type": "path",
                "description": "The Organization ID"
              },
              {
                "name": "appId",
                "value": "sample-app",
                "type": "path",
                "description": "The Application ID"
              },
              {
                "name": "archived",
                "value": "",
                "type": "query",
                "description": "If true, return archived Deltas.\n\n"
              },
              {
                "name": "env",
                "value": "",
                "type": "query",
                "description": "Only return Deltas associated with the specified Environment.\n\n"
              }
            ]
          },
