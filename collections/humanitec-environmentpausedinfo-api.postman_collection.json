          "name": "Pause / Resume an environment.",
          "request": {
            "name": "Pause / Resume an environment.",
            "description": {
              "content": "On pause requests, all the Kubernetes Deployment resources are scaled down to 0 replicas. On resume requests, all the Kubernetes Deployment resources are scaled up to the number of replicas running before the environment was paused. When an environment is paused, it is not possible to:```\n  - Deploy the environment within Humanitec.\n  - Scale the number of replicas running of any workload.\n```",
              "type": "text/plain"
            },
